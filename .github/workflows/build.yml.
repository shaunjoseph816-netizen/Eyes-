name: Build Eyes
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.9
      - name: Generate app
        run: |
          mkdir -p app/src/main/java/com/eyes app/src/main/res/xml app/src/main/res/values
          cat > settings.gradle <<'EOF'
          pluginManagement { repositories { google(); mavenCentral(); gradlePluginPortal() } }
          dependencyResolutionManagement { repositories { google(); mavenCentral() } }
          include ':app'
          EOF
          cat > build.gradle <<'EOF'
          plugins { id 'com.android.application' version '8.5.2' apply false }
          EOF
          cat > app/build.gradle <<'EOF'
          plugins { id 'com.android.application' }
          android {
          namespace 'com.eyes'
          compileSdk 34
          defaultConfig { applicationId 'com.eyes'; minSdk 30; targetSdk 34; versionCode 2; versionName '2' }
          compileOptions { sourceCompatibility JavaVersion.VERSION_17; targetCompatibility JavaVersion.VERSION_17 }
          }
          EOF
          cat > app/src/main/AndroidManifest.xml <<'EOF'
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
          <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
          <uses-permission android:name="android.permission.WAKE_LOCK"/>
          <queries><package android:name="com.tradingview.tradingviewapp"/><package android:name="com.metaquotes.metatrader5"/></queries>
          <application android:label="Eyes">
          <activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
          <service android:name=".EyesService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"><intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter><meta-data android:name="android.accessibilityservice" android:resource="@xml/eyes_config"/></service>
          </application>
          </manifest>
          EOF
          cat > app/src/main/res/xml/eyes_config.xml <<'EOF'
          <accessibility-service xmlns:android="http://schemas.android.com/apk/res/android" android:accessibilityEventTypes="typeWindowStateChanged" android:accessibilityFeedbackType="feedbackGeneric" android:canRetrieveWindowContent="true" android:canTakeScreenshot="true" android:canPerformGestures="true" android:accessibilityFlags="flagDefault" android:description="@string/d" android:notificationTimeout="100"/>
          EOF
          cat > app/src/main/res/values/strings.xml <<'EOF'
          <resources><string name="d">Lets Eyes read the chart, follow the signal and tap in MT5.</string></resources>
          EOF
          cat > app/src/main/java/com/eyes/MainActivity.java <<'EOF'
          package com.eyes;
          import android.app.Activity;
          import android.content.Intent;
          import android.content.SharedPreferences;
          import android.os.Build;
          import android.os.Bundle;
          import android.provider.Settings;
          import android.widget.*;
          public class MainActivity extends Activity {
          static TextView out;
          SharedPreferences sp;
          Button mk(LinearLayout l, String t) { Button b = new Button(this); b.setText(t); l.addView(b); return b; }
          void flag(Button b, String n, String k) { b.setText(n + ": " + (sp.getBoolean(k, false) ? "ON" : "OFF")); }
          void tog(Button b, String n, String k) {
          flag(b, n, k);
          b.setOnClickListener(v -> { sp.edit().putBoolean(k, !sp.getBoolean(k, false)).apply(); flag(b, n, k); });
          }
          protected void onCreate(Bundle s) {
          super.onCreate(s);
          sp = getSharedPreferences("eyes", 0);
          if (Build.VERSION.SDK_INT >= 33) requestPermissions(new String[]{"android.permission.POST_NOTIFICATIONS"}, 1);
          LinearLayout l = new LinearLayout(this);
          l.setOrientation(LinearLayout.VERTICAL);
          l.setPadding(40, 120, 40, 40);
          mk(l, "1. Turn on Eyes in Accessibility").setOnClickListener(v -> startActivity(new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)));
          mk(l, "2. Check signal now").setOnClickListener(v -> {
          if (EyesService.me == null) out.setText("Eyes is off. Do step 1.");
          else { out.setText("Looking..."); EyesService.me.check(); }
          });
          tog(mk(l, ""), "Auto-check every 30 min", "auto");
          tog(mk(l, ""), "Place trades", "trade");
          mk(l, "Forget last signal").setOnClickListener(v -> sp.edit().remove("last").apply());
          out = new TextView(this);
          out.setTextSize(20);
          out.setText(EyesService.last);
          l.addView(out);
          setContentView(l);
          }
          }
          EOF
          cat > app/src/main/java/com/eyes/EyesService.java <<'EOF'
          package com.eyes;
          import android.accessibilityservice.AccessibilityService;
          import android.accessibilityservice.GestureDescription;
          import android.app.Notification;
          import android.app.NotificationChannel;
          import android.app.NotificationManager;
          import android.content.Intent;
          import android.content.SharedPreferences;
          import android.graphics.Bitmap;
          import android.graphics.Path;
          import android.hardware.HardwareBuffer;
          import android.os.Handler;
          import android.os.Looper;
          import android.os.PowerManager;
          import android.util.DisplayMetrics;
          import android.view.Display;
          import android.view.accessibility.AccessibilityEvent;
          import android.view.accessibility.AccessibilityNodeInfo;
          import android.widget.Toast;
          import java.util.Calendar;
          import java.util.List;
          public class EyesService extends AccessibilityService {
          static EyesService me;
          static String last = "No check yet.";
          Handler h = new Handler(Looper.getMainLooper());
          SharedPreferences sp;
          int lastSlot = -1;
          Runnable loop = new Runnable() {
          public void run() {
          Calendar c = Calendar.getInstance();
          int m = c.get(Calendar.MINUTE);
          int slot = c.get(Calendar.DAY_OF_YEAR) * 100 + c.get(Calendar.HOUR_OF_DAY) * 2 + (m >= 30 ? 1 : 0);
          if (sp.getBoolean("auto", false) && m % 30 == 0 && c.get(Calendar.SECOND) >= 8 && slot != lastSlot) { lastSlot = slot; check(); }
          h.postDelayed(this, 5000);
          }
          };
          public void onServiceConnected() { me = this; sp = getSharedPreferences("eyes", 0); h.removeCallbacks(loop); h.post(loop); }
          public void onAccessibilityEvent(AccessibilityEvent e) {}
          public void onInterrupt() {}
          public boolean onUnbind(Intent i) { me = null; return super.onUnbind(i); }
          void say(String t) {
          last = t;
          if (MainActivity.out != null) MainActivity.out.setText(t);
          Toast.makeText(this, t, Toast.LENGTH_LONG).show();
          }
          void note(String t) {
          say(t);
          NotificationManager nm = getSystemService(NotificationManager.class);
          nm.createNotificationChannel(new NotificationChannel("eyes", "Eyes", NotificationManager.IMPORTANCE_HIGH));
          nm.notify((int) (System.currentTimeMillis() % 100000), new Notification.Builder(this, "eyes").setSmallIcon(android.R.drawable.ic_dialog_info).setContentTitle("Eyes").setContentText(t).setStyle(new Notification.BigTextStyle().bigText(t)).build());
          }
          void open(String pkg) {
          Intent i = getPackageManager().getLaunchIntentForPackage(pkg);
          if (i == null) { say("App not found: " + pkg); return; }
          i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
          startActivity(i);
          }
          void check() {
          PowerManager pm = (PowerManager) getSystemService(POWER_SERVICE);
          pm.newWakeLock(PowerManager.SCREEN_BRIGHT_WAKE_LOCK | PowerManager.ACQUIRE_CAUSES_WAKEUP, "eyes:w").acquire(120000);
          open("com.tradingview.tradingviewapp");
          h.postDelayed(() -> tap("Chart"), 3500);
          h.postDelayed(() -> shot(), 6500);
          }
          void decide(int bc) {
          if (bc == 0) { note("No big label found."); return; }
          String now = bc == 1 ? "GREEN" : "RED";
          String old = sp.getString("last", "");
          sp.edit().putString("last", now).apply();
          if (old.isEmpty()) { note("Started: " + now + ". No trade yet; waiting for a change."); return; }
          if (old.equals(now)) { note("No change: still " + now + "."); return; }
          boolean buy = bc == 1;
          if (!sp.getBoolean("trade", false)) { note("Signal turned " + now + ". Trading is OFF, so I would close all and " + (buy ? "BUY" : "SELL") + "."); return; }
          note("Signal turned " + now + ". Closing all, then " + (buy ? "BUY" : "SELL") + ".");
          open("com.metaquotes.metatrader5");
          h.postDelayed(() -> tapXY(0.5f, 0.906f), 4000);
          h.postDelayed(() -> tapXY(0.936f, 0.288f), 6000);
          h.postDelayed(() -> tap("Close All Positions"), 8000);
          h.postDelayed(() -> tap("Charts"), 11000);
          h.postDelayed(() -> tapXY(buy ? 0.833f : 0.139f, 0.125f), 13500);
          h.postDelayed(() -> note("Done: " + (buy ? "BUY" : "SELL") + " tapped. Check MT5."), 15500);
          }
          void tapXY(float fx, float fy) {
          DisplayMetrics d = getResources().getDisplayMetrics();
          Path p = new Path();
          p.moveTo(fx * d.widthPixels, fy * d.heightPixels);
          dispatchGesture(new GestureDescription.Builder().addStroke(new GestureDescription.StrokeDescription(p, 0, 60)).build(), null, null);
          }
          void tap(String t) {
          AccessibilityNodeInfo r = getRootInActiveWindow();
          if (r == null) return;
          List<AccessibilityNodeInfo> l = r.findAccessibilityNodeInfosByText(t);
          for (AccessibilityNodeInfo n : l) {
          AccessibilityNodeInfo x = n;
          while (x != null && !x.isClickable()) x = x.getParent();
          if (x != null) { x.performAction(AccessibilityNodeInfo.ACTION_CLICK); return; }
          }
          }
          void shot() {
          takeScreenshot(Display.DEFAULT_DISPLAY, getMainExecutor(), new TakeScreenshotCallback() {
          public void onSuccess(ScreenshotResult s) {
          HardwareBuffer hb = s.getHardwareBuffer();
          Bitmap bm = Bitmap.wrapHardwareBuffer(hb, s.getColorSpace()).copy(Bitmap.Config.ARGB_8888, false);
          hb.close();
          decide(find(bm));
          }
          public void onFailure(int c) { note("Screenshot failed (" + c + ")."); }
          });
          }
          static int box(int[] a, int W, int x, int y, int w, int h) {
          return a[(y + h) * W + x + w] - a[y * W + x + w] - a[(y + h) * W + x] + a[y * W + x];
          }
          int find(Bitmap bm) {
          int w = bm.getWidth(), hh = bm.getHeight();
          int[] p = new int[w * hh];
          bm.getPixels(p, 0, w, 0, 0, w, hh);
          int W = w + 1;
          int[] G = new int[W * (hh + 1)], R = new int[W * (hh + 1)];
          for (int y = 0; y < hh; y++) {
          int gs = 0, rs = 0;
          for (int x = 0; x < w; x++) {
          int c = p[y * w + x], r = (c >> 16) & 255, g = (c >> 8) & 255, b = c & 255;
          if (r >= 60 && r <= 95 && g >= 160 && g <= 190 && b >= 65 && b <= 95) gs++;
          if (r >= 230 && g >= 40 && g <= 72 && b >= 55 && b <= 88) rs++;
          G[(y + 1) * W + x + 1] = G[y * W + x + 1] + gs;
          R[(y + 1) * W + x + 1] = R[y * W + x + 1] + rs;
          }
          }
          int ww = (int) (w * 0.06), wh = (int) (hh * 0.03), area = ww * wh;
          int x1 = (int) (w * 0.80) - ww, y0 = (int) (hh * 0.17), y1 = (int) (hh * 0.78) - wh;
          int bx = -1, bc = 0;
          for (int y = y0; y <= y1; y += 3) {
          for (int x = 0; x <= x1; x += 3) {
          int g = box(G, W, x, y, ww, wh), r = box(R, W, x, y, ww, wh);
          if (g > 0.6 * area || r > 0.6 * area) { if (x >= bx) { bx = x; bc = g > r ? 1 : 2; } }
          }
          }
          return bc;
          }
          }
          EOF
      - name: Build
        run: gradle assembleDebug --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: eyes-apk
          path: app/build/outputs/apk/debug/app-debug.apk
